{
    "name": "amwalpay/ecr-php",
    "description": "Amwal Pay ECR SDK for PHP: drive an Amwal POS terminal over Wi-Fi, USB cable or the Amwal ECR Web Service (sale, void, refund, inquiry, e-receipt, close receipt, settlement) with the same safety rules as the Windows/.NET SDK.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "amwal",
        "amwalpay",
        "ecr",
        "pos",
        "payments",
        "terminal",
        "settlement",
        "usb",
        "oman"
    ],
    "homepage": "https://github.com/amwal-pay/AmwalpayEcrPhp",
    "authors": [
        {
            "name": "Amwal Pay",
            "homepage": "https://www.amwal-pay.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-ffi": "USB cable on Windows: drives the COM port through kernel32 (extension=ffi, ffi.enable=true under a web server)",
        "ext-sockets": "Lets the integration tests simulate a TCP reset; not needed at runtime",
        "psr/log": "Route SDK diagnostics to any PSR-3 logger through AmwalPay\\Ecr\\Log\\PsrLoggerAdapter"
    },
    "autoload": {
        "psr-4": {
            "AmwalPay\\Ecr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmwalPay\\Ecr\\Tests\\": "tests/"
        },
        "classmap": [
            "examples/src/"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "check:secrets": "@php tools/check-secrets.php",
        "build": "@php tools/build-artifact.php",
        "test:example": "phpunit --testsuite example"
    },
    "config": {
        "sort-packages": true,
        "platform-check": true
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/dist",
            "/tools",
            "/.github",
            "/phpunit.xml.dist",
            "/.phpunit.cache",
            "/vendor"
        ]
    }
}
